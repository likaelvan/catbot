# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here

# Optional settings (defaults shown)
# CHAT_MODEL=openai/gpt-oss-120b         # or openai/gpt-oss-20b (faster) or qwen/qwen3.8-27b
# REASONING_EFFORT=low                    # gpt-oss thinking time: low / medium / high
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=                           # blank = auto-detect, or "en", "tl"
# TTS_VOICE=en-US-AriaNeural              # list all: edge-tts --list-voices
# PORT=8000
# HOME_CITY=Manila                        # default city for weather
# TIMEZONE=Asia/Manila                    # for timers and reminders
